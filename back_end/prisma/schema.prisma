generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  BUREAU
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfessionType {
  STUDENT
  WORKER
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                  Int                    @id @default(autoincrement())
  email               String                 @unique
  passwordHash        String
  role                UserRole               @default(MEMBER)
  isApproved          Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  profile             MemberProfile?
  procurations        ProcurationRequest[]
  reclamations        Reclamation[]
  certificates        CertificateSubmission[]
  publishedAnnouncements Announcement[]      @relation("AnnouncementAuthor")
  publishedEvents     BureauEvent[]          @relation("EventAuthor")
}

model MemberProfile {
  id                   Int            @id @default(autoincrement())
  userId               Int            @unique
  firstName            String
  lastName             String
  phone                String?
  address              String?
  domicileAtMarrakech  String?
  matricule            String?        @unique
  cinNumber            String?        @unique
  birthDate            DateTime?
  professionType       ProfessionType @default(STUDENT)
  school               String?
  track                String?
  jobTitle             String?
  passportNumber       String?
  residenceCardNumber  String?
  arrivalDate          DateTime?
  facebookName         String?
  imageUrl             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProcurationRequest {
  id               Int           @id @default(autoincrement())
  userId           Int
  title            String
  status           RequestStatus @default(PENDING)
  ownerFirstName   String
  ownerLastName    String
  ownerPhone       String
  ownerAddress     String
  ownerMatricule   String
  ownerCinNumber   String
  proxyFullName    String
  proxyCinNumber   String
  requestDate      DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reclamation {
  id           Int           @id @default(autoincrement())
  userId       Int
  subject      String
  message      String        @db.Text
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CertificateSubmission {
  id             Int           @id @default(autoincrement())
  userId         Int
  schoolYear     String
  fileName       String
  reference      String?
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int       @id @default(autoincrement())
  title        String
  message      String    @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedBy  Int
  author       User      @relation("AnnouncementAuthor", fields: [publishedBy], references: [id], onDelete: Cascade)
}

model BureauEvent {
  id           Int         @id @default(autoincrement())
  title        String
  description  String      @db.Text
  location     String?
  eventDate    DateTime?
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  publishedBy  Int
  author       User        @relation("EventAuthor", fields: [publishedBy], references: [id], onDelete: Cascade)
}

model BureauMember {
  id           Int      @id @default(autoincrement())
  fullName     String
  title        String
  school       String?
  track        String?
  level        String?
  mission      String?
  imageUrl     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}